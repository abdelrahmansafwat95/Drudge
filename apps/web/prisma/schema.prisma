generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TEAM_LEADER
  AGENT
  CLIENT_USER
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  branches      Branch[]
  teams         Team[]
  clients       Client[]
  chemicals     Chemical[]
  notifications Notification[]
  reports       Report[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  teams        Team[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  email          String    @unique
  passwordHash   String
  role           Role
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  teamMembers   TeamMember[]
  ledTeams      Team[]         @relation("TeamLeader")
  notifications Notification[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  leaderId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  leader       User?        @relation("TeamLeader", fields: [leaderId], references: [id])
  members      TeamMember[]
  visits       Visit[]
  schedules    Schedule[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  sites        Site[]
  contracts    Contract[]
}

model Contract {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  startDate DateTime
  endDate   DateTime
  value     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model Site {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id])
  zones     Zone[]
  visits    Visit[]
  schedules Schedule[]
}

model Zone {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id])
}

model Schedule {
  id         String   @id @default(cuid())
  siteId     String
  teamId     String
  frequency  String
  dayOfWeek  Int?
  dayOfMonth Int?
  timeOfDay  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
}

model Visit {
  id          String      @id @default(cuid())
  siteId      String
  teamId      String
  scheduleId  String?
  status      VisitStatus @default(SCHEDULED)
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  signature   String?
  signedBy    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  site           Site            @relation(fields: [siteId], references: [id])
  team           Team            @relation(fields: [teamId], references: [id])
  checklistItems ChecklistItem[]
  findings       Finding[]
  chemicalLogs   ChemicalLog[]
  reports        Report[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  visitId     String
  description String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  visit Visit @relation(fields: [visitId], references: [id])
}

model Finding {
  id          String          @id @default(cuid())
  visitId     String
  description String
  severity    FindingSeverity @default(LOW)
  location    String?
  imageUrl    String?
  isResolved  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  visit Visit @relation(fields: [visitId], references: [id])
}

model Chemical {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  activeIngredient String?
  unit             String   @default("ml")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  logs         ChemicalLog[]
}

model ChemicalLog {
  id         String   @id @default(cuid())
  visitId    String
  chemicalId String
  quantity   Float
  notes      String?
  createdAt  DateTime @default(now())

  visit    Visit    @relation(fields: [visitId], references: [id])
  chemical Chemical @relation(fields: [chemicalId], references: [id])
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  visitId        String?
  title          String
  type           String
  language       String   @default("en")
  fileUrl        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  visit        Visit?       @relation(fields: [visitId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}
